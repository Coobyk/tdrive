<Window
    x:Class="TDrive.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TDrive.WinUI"
    Title="TDrive">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="TDrive" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSubtitle" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <ProgressRing x:Name="SyncRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Global Status / Error / Invite InfoBar -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,8"
            IsOpen="False"
            IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="InfoBarActionBtn" Content="Copy" Visibility="Collapsed" Click="InfoBarActionBtn_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Auth / Onboarding Overlay -->
        <Grid x:Name="OnboardingGrid" Grid.Row="2" Visibility="Visible">
            <Border
                Width="420"
                Padding="28"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid>
                    <!-- Setup -->
                    <StackPanel x:Name="SetupPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Connect to Telegram" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Create an application at my.telegram.org to obtain your API ID and API Hash." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="Open my.telegram.org" NavigateUri="https://my.telegram.org" Padding="0" />
                        <TextBox x:Name="ApiIdBox" Header="API ID" PlaceholderText="e.g. 12345678" KeyDown="SetupBox_KeyDown" />
                        <TextBox x:Name="ApiHashBox" Header="API Hash" PlaceholderText="32-character hex hash" KeyDown="SetupBox_KeyDown" />
                        <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SaveSetup_Click" />
                    </StackPanel>

                    <!-- Connecting -->
                    <StackPanel x:Name="ConnectingPanel" Spacing="16" HorizontalAlignment="Center" Visibility="Visible">
                        <ProgressRing IsActive="True" Width="36" Height="36" />
                        <TextBlock x:Name="ConnectingLabel" Text="Connecting to Telegram..." Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel x:Name="AuthPhonePanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Sign in to Telegram" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Enter your phone number including country code." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="PhoneBox" Header="Phone number" PlaceholderText="+1 555 123 4567" KeyDown="PhoneBox_KeyDown" />
                        <Button Content="Send login code" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="RequestCode_Click" />
                    </StackPanel>

                    <!-- Code -->
                    <StackPanel x:Name="AuthCodePanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Enter login code" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Check your Telegram app or SMS for the verification code." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="CodeBox" Header="Code" PlaceholderText="12345" KeyDown="CodeBox_KeyDown" />
                        <Button Content="Sign in" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SubmitCode_Click" />
                    </StackPanel>

                    <!-- 2FA Password -->
                    <StackPanel x:Name="AuthPasswordPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Two-step verification" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="PasswordHintLabel" Text="Enter your Telegram cloud password." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <PasswordBox x:Name="PasswordBox" Header="Cloud password" KeyDown="PasswordBox_KeyDown" />
                        <Button Content="Unlock account" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SubmitPassword_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Fluent App Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            Visibility="Collapsed"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="230"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="My Drive" Tag="drive">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Drives" Tag="drives">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Trash" Tag="trash">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Unadopted" Tag="unadopted">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Accounts" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="VaultNavItem" Content="Vault" Tag="vault">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page: Drive Browser -->
                <Grid x:Name="DrivePage" Grid.Row="0" Padding="20,12,20,12" Visibility="Visible"
                      AllowDrop="True" DragOver="DrivePage_DragOver" Drop="DrivePage_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar + Search -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CommandBar DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left">
                            <CommandBar.Resources>
                                <SolidColorBrush x:Key="CommandBarBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                                <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />
                            </CommandBar.Resources>
                            <AppBarButton Icon="Upload" Label="Upload files" Click="UploadFiles_Click" />
                            <AppBarButton Icon="Folder" Label="Upload folder" Click="UploadFolder_Click" />
                            <AppBarButton Icon="NewFolder" Label="New folder" Click="NewFolder_Click" />
                            <AppBarButton Icon="Sync" Label="Sync" Click="Sync_Click" />
                            <AppBarSeparator />
                            <AppBarToggleButton x:Name="GridToggleBtn" Icon="ViewAll" Label="Grid" Click="ToggleView_Click" />
                            <AppBarButton x:Name="SortBtn" Icon="Sort" Label="Sort: Name" Click="ToggleSort_Click" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton x:Name="VaultActionBtn" Icon="ProtectedDocument" Label="Vault / Encryption" Click="VaultAction_Click" />
                                <AppBarButton Icon="Repair" Label="Optimize drive" Click="OptimizeDrive_Click" />
                                <AppBarButton Icon="Play" Label="Resume pending uploads" Click="ResumeUploads_Click" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>

                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Width="240"
                            PlaceholderText="Search this folder..."
                            QueryIcon="Find"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <!-- Breadcrumb + Stats -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpFolderBtn" Grid.Column="0" Margin="0,0,8,0" ToolTipService.ToolTip="Up one folder" Click="UpFolder_Click" IsEnabled="False">
                            <FontIcon Glyph="&#xE74A;" FontSize="13" />
                        </Button>
                        <BreadcrumbBar x:Name="PathBreadcrumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="PathBreadcrumbs_ItemClicked" />
                        <TextBlock x:Name="FolderStatsLabel" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </Grid>

                    <!-- List View -->
                    <ListView
                        x:Name="EntriesListView"
                        Grid.Row="2"
                        SelectionMode="Extended"
                        IsDoubleTapEnabled="True"
                        DoubleTapped="Entries_DoubleTapped"
                        RightTapped="Entries_RightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DriveEntryViewModel">
                                <Grid Padding="6,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="28" Height="28" CornerRadius="4">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind BadgesText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DateText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Grid View -->
                    <GridView
                        x:Name="EntriesGridView"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        SelectionMode="Extended"
                        IsDoubleTapEnabled="True"
                        DoubleTapped="Entries_DoubleTapped"
                        RightTapped="Entries_RightTapped">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:DriveEntryViewModel">
                                <Border Width="154" Height="154" Padding="10" Margin="4" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="36" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="{x:Bind SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Empty Folder State -->
                    <StackPanel x:Name="EmptyFolderPanel" Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="This folder is empty" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop files here or use Upload files in the toolbar." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Page: Drives Picker -->
                <Grid x:Name="DrivesPage" Grid.Row="0" Padding="24,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Your Drives" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Select a Telegram channel drive or create a new one." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="New personal drive" Style="{StaticResource AccentButtonStyle}" Click="CreatePersonalDrive_Click" />
                            <Button Content="New shared drive" Click="CreateSharedDrive_Click" />
                            <Button Content="Join invite link" Click="JoinInvite_Click" />
                            <Button ToolTipService.ToolTip="Refresh drives" Click="RefreshDrives_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="DrivesListView" Grid.Row="1" IsItemClickEnabled="True" ItemClick="DrivesListView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelDto">
                                <Border Padding="14,12" Margin="0,4" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind KindLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Page: Trash -->
                <Grid x:Name="TrashPage" Grid.Row="0" Padding="24,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Trash" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Restore deleted files or permanently purge them." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Empty trash" VerticalAlignment="Center" Click="EmptyTrash_Click" />
                    </Grid>
                    <ListView x:Name="TrashListView" Grid.Row="1">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TrashDto">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind OriginalName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind DeletedLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Restore" Tag="{x:Bind ObjectId}" Click="RestoreTrashItem_Click" />
                                    <Button Grid.Column="3" Content="Purge" Tag="{x:Bind ObjectId}" Click="PurgeTrashItem_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Page: Unadopted (Shared Drive Attachments) -->
                <Grid x:Name="UnadoptedPage" Grid.Row="0" Padding="24,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="2">
                        <TextBlock Text="Unadopted attachments" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Raw files sent directly to a shared Telegram channel can be adopted into your drive." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ListView x:Name="UnadoptedListView" Grid.Row="1">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UnadoptedDto">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Adopt" Tag="{x:Bind MsgId}" Click="AdoptItem_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Page: Accounts -->
                <Grid x:Name="AccountsPage" Grid.Row="0" Padding="24,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Accounts" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Switch between signed-in Telegram accounts." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Add account" Style="{StaticResource AccentButtonStyle}" Click="AddAccount_Click" />
                            <Button Content="Sign out" Click="SignOut_Click" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="AccountsListView" Grid.Row="1">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AccountDto">
                                <Border Padding="14,12" Margin="0,4" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind StatusBadge}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind DrivesSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Switch" Tag="{x:Bind Id}" Click="SwitchAccount_Click" />
                                        <Button Grid.Column="2" Content="Remove" Tag="{x:Bind Id}" Click="RemoveAccount_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Collapsible Transfers Drawer -->
                <Expander
                    x:Name="TransfersExpander"
                    Grid.Row="1"
                    Margin="16,0,16,12"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="Collapsed"
                    IsExpanded="True">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TransfersHeaderText" Text="Transfers" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button Grid.Column="1" Content="Clear finished" Margin="0,0,8,0" Click="ClearFinishedTransfers_Click" />
                        </Grid>
                    </Expander.Header>
                    <ListView x:Name="TransfersListView" MaxHeight="180" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TransferViewModel">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Pause" Tag="{x:Bind Id}" Visibility="{x:Bind CanPause, Mode=OneWay}" Click="PauseTransfer_Click" />
                                    <Button Grid.Column="2" Content="Resume" Tag="{x:Bind Id}" Visibility="{x:Bind CanResume, Mode=OneWay}" Click="ResumeTransfer_Click" />
                                    <Button Grid.Column="3" Content="Cancel" Tag="{x:Bind Id}" Visibility="{x:Bind CanCancel, Mode=OneWay}" Click="CancelTransfer_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
